{
  "name": "dogear-vscode",
  "displayName": "Dogear",
  "description": "Collect code, text, and image selections with multimodal questions, then compose them for Claude Code or Codex.",
  "version": "0.2.1",
  "publisher": "ylsung",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ylsung/dogear.git",
    "directory": "vscode"
  },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dogear.askSelection",
        "title": "Dogear: Add query for selection"
      },
      {
        "command": "dogear.askImage",
        "title": "Dogear: Add query for image"
      },
      {
        "command": "dogear.askTab",
        "title": "Dogear: Ask tab without selection"
      },
      {
        "command": "dogear.captureScreenshot",
        "title": "Dogear: Capture screenshot and ask"
      },
      {
        "command": "dogear.askCodexSelection",
        "title": "Dogear: Add selected Codex text"
      },
      {
        "command": "dogear.askClaudeSelection",
        "title": "Dogear: Add selected Claude Code text"
      },
      {
        "command": "dogear.askMarkdownPreviewSelection",
        "title": "Dogear: Add selected preview text"
      },
      {
        "command": "dogear.exportPrompt",
        "title": "Dogear: Export prompt…"
      },
      {
        "command": "dogear.clearQueue",
        "title": "Dogear: Clear queue"
      },
      {
        "command": "dogear.undoClear",
        "title": "Dogear: Undo clear queue"
      },
      {
        "command": "dogear.openQueue",
        "title": "Dogear: Open queue"
      },
      {
        "command": "dogear.openSettings",
        "title": "Dogear: Settings",
        "icon": "$(gear)"
      },
      {
        "command": "dogear.openShortcuts",
        "title": "Dogear: Keyboard shortcuts",
        "icon": "$(keyboard)"
      }
    ],
    "keybindings": [
      {
        "command": "dogear.askSelection",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "editorTextFocus"
      },
      {
        "command": "dogear.askMarkdownPreviewSelection",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor'"
      },
      {
        "command": "dogear.exportPrompt",
        "key": "ctrl+shift+x",
        "mac": "cmd+shift+x"
      },
      {
        "command": "dogear.clearQueue",
        "key": "ctrl+shift+0",
        "mac": "cmd+shift+0"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "dogear.askSelection",
          "when": "editorHasSelection",
          "group": "dogear"
        }
      ],
      "explorer/context": [
        {
          "command": "dogear.askImage",
          "when": "resourceExtname =~ /\\.(png|jpe?g|gif|webp|bmp|svg)$/i",
          "group": "dogear"
        }
      ],
      "editor/title/context": [
        {
          "command": "dogear.askImage",
          "when": "resourceExtname =~ /\\.(png|jpe?g|gif|webp|bmp|svg)$/i",
          "group": "dogear"
        }
      ],
      "webview/context": [
        {
          "command": "dogear.askCodexSelection",
          "when": "webviewId == 'chatgpt.sidebarView' || webviewId == 'chatgpt.sidebarSecondaryView' || webviewId == 'chatgpt.conversationEditor'",
          "group": "dogear"
        },
        {
          "command": "dogear.askClaudeSelection",
          "when": "webviewId == 'claudeVSCodeSidebar' || webviewId == 'claudeVSCodeSidebarSecondary' || webviewId == 'claudeVSCodePanel'",
          "group": "dogear"
        },
        {
          "command": "dogear.askMarkdownPreviewSelection",
          "when": "webviewId == 'markdown.preview' || webviewId == 'vscode.markdown.preview.editor'",
          "group": "dogear"
        }
      ],
      "view/title": [
        {
          "command": "dogear.openShortcuts",
          "when": "view == dogear.queue",
          "group": "navigation@1"
        },
        {
          "command": "dogear.openSettings",
          "when": "view == dogear.queue",
          "group": "navigation@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dogear",
          "title": "Dogear",
          "icon": "media/dogear.svg"
        }
      ]
    },
    "views": {
      "dogear": [
        {
          "type": "webview",
          "id": "dogear.queue",
          "name": "Queue",
          "icon": "media/dogear.svg"
        }
      ]
    },
    "configuration": {
      "title": "Dogear",
      "properties": {
        "dogear.appearance": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "enumDescriptions": [
            "Follow the VS Code color theme.",
            "Always use the light palette.",
            "Always use the dark palette."
          ],
          "default": "auto",
          "markdownDescription": "Light or dark palette for the Dogear sidebar. Keyboard shortcuts are changed in [Keyboard Shortcuts](command:dogear.openShortcuts)."
        },
        "dogear.promptLanguage": {
          "type": "string",
          "enum": [
            "en",
            "zh-TW"
          ],
          "enumDescriptions": [
            "English",
            "繁體中文 (Traditional Chinese)"
          ],
          "default": "en",
          "description": "Language of the composed prompt sent to the AI (not the sidebar interface)."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "node esbuild.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.5.0"
  }
}
